{
  "name": ".NET 10 + MySQL",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1": {},
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/Agustin-Gigena/devcontainer-features/dotnet-tools:1": {
      "tools": "dotnet-ef, dotnet-stryker"
    },
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "podman, yamllint libxcb-shm0 libx11-xcb1 libx11-6 libxcb1 libxext6 libxrandr2 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libgtk-3-0t64 libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0t64 libcairo-gobject2 libcairo2 libgdk-pixbuf-2.0-0 libxrender1 libasound2t64 libfreetype6 libfontconfig1 libdbus-1-3 libnss3 libnspr4 libatk-bridge2.0-0t64 libdrm2 libxkbcommon0 libatspi2.0-0t64 libcups2t64 libxshmfence1 libgbm1 fonts-noto-color-emoji fonts-noto-cjk fonts-freefont-ttf"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.omp",
      "target": "/home/vscode/.omp",
      "type": "bind"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/gh/",
      "target": "/home/vscode/.config/gh/"
    },
    {
      "type": "bind",
      "source": "${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock",
      "target": "/run/podman.sock"
    }
  ],
  "runArgs": [
    "--userns=keep-id",
    "--memory=3g",
    "--cpus=2",
    "--name",
    "enigma-devcontainer",
    "--network",
    "enigma-dev-net",
    "--publish",
    "127.0.0.1:8080:8080",
    "--publish",
    "127.0.0.1:8081:8081"
  ],
  "initializeCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": {
    "Install agent-browser": "npm install -g --allow-scripts=agent-browser && agent-browser install",
    "Install playwright": "bash .devcontainer/install-playwright.sh",
    "Configure git identity": "bash .devcontainer/configure-git-identity.sh"
  },
  "postStartCommand": "DEV_START_DETACHED=1 bash .devcontainer/start-dev.sh",
  "remoteEnv": {
    "PODMAN_SOCKET": "/run/podman.sock",
    "DB_IMAGE_REPO": "ghcr.io/agustin-gigena/enigma-dev-db",
    "MYSQL_HOST": "enigma-dev-db",
    "MYSQL_PORT": "3306",
    "MYSQL_DATABASE": "enigma_db",
    "MYSQL_USER": "root",
    "MYSQL_PASSWORD": "root_password",
    "MYSQL_ROOT_PASSWORD": "root_password"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "remote.autoForwardPortSource": "process"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "patcx.vscode-nuget-gallery",
        "ms-azuretools.vscode-containers"
      ]
    }
  },
  "portsAttributes": {
    "*": {
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}