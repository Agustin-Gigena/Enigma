{
  "name": ".NET 10 + MySQL",
  "initializeCommand": "podman network exists enigma-dev-net || podman network create enigma-dev-net",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1": {},
    "ghcr.io/agustin-gigena/devcontainer-features/dotnet-ef:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    {
      "source": "${env:HOME}/.omp",
      "target": "/root/.omp",
      "type": "bind"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/gh/",
      "target": "/root/.config/gh/"
    },
    {
      "type": "bind",
      "source": "/run/user/1000/podman/podman.sock",
      "target": "/run/user/1000/podman/podman.sock"

    }
  ],
  "runArgs": [
    "--name",
    "enigma-devcontainer",
    "--network",
    "enigma-dev-net",
    "--publish",
    "127.0.0.1:80:18080",
    "--publish",
    "127.0.0.1:8081:18081"
  ],
  "postCreateCommand": {
    "Update package index": "apt-get update",
    "Install podman and curl": "apt-get install -y --no-install-recommends podman curl",
    "Install lefthook": "bash <(curl -fsSL https://raw.githubusercontent.com/evilmartians/lefthook/master/install.sh)",
    "Register lefthook hooks": "lefthook install"
  },
  "postStartCommand": "bash .devcontainer/start-dev.sh",
  "remoteEnv": {
    "DB_IMAGE_REPO": "ghcr.io/agustin-gigena/enigma-dev-db",
    "MYSQL_HOST": "enigma-dev-db",
    "MYSQL_PORT": "3306",
    "MYSQL_DATABASE": "enigma_db",
    "MYSQL_USER": "root",
    "MYSQL_PASSWORD": "root_password",
    "MYSQL_ROOT_PASSWORD": "root_password"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "remote.autoForwardPortSource": "process"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "patcx.vscode-nuget-gallery"
      ]
    }
  },
  "portsAttributes": {
    "*": {
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }

}