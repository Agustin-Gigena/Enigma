{
  "name": ".NET 10 + MySQL",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1": {},
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node:2.1.0",
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1",
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1"
  ],
  "containerUser": "dotnet",
  "remoteUser": "dotnet",
  "updateRemoteUserUID": false,
  "mounts": [
    {
      "source": "${localEnv:HOME}/.omp",
      "target": "/home/dotnet/.omp",
      "type": "bind"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/gh/",
      "target": "/home/dotnet/.config/gh/"
    },
    {
      "type": "bind",
      "source": "${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock",
      "target": "/run/podman.sock"
    }
  ],
  "runArgs": [
    "--memory=3g",
    "--cpus=2",
    "--name",
    "enigma-devcontainer",
    "--network",
    "enigma-dev-net",
    "--publish",
    "127.0.0.1:8080:8080",
    "--publish",
    "127.0.0.1:8081:8081"
  ],
  "initializeCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": {
    "Install agent-browser": "npm install -g agent-browser && agent-browser install --with-deps",
    "Configure git identity": "bash .devcontainer/configure-git-identity.sh"
  },
  "postStartCommand": "DEV_START_DETACHED=1 bash .devcontainer/start-dev.sh",
  "remoteEnv": {
    "PODMAN_SOCKET": "/run/podman.sock",
    "DB_IMAGE_REPO": "ghcr.io/agustin-gigena/enigma-dev-db",
    "MYSQL_HOST": "enigma-dev-db",
    "MYSQL_PORT": "3306",
    "MYSQL_DATABASE": "enigma_db",
    "MYSQL_USER": "root",
    "MYSQL_PASSWORD": "root_password",
    "MYSQL_ROOT_PASSWORD": "root_password"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "remote.autoForwardPortSource": "process"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "patcx.vscode-nuget-gallery",
        "ms-azuretools.vscode-containers"
      ]
    }
  },
  "portsAttributes": {
    "*": {
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}