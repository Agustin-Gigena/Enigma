{
  "name": ".NET 10 + MySQL",
  "dockerComposeFile": "compose.json",
  "service": "dev",
  "workspaceFolder": "/workspaces/Enigma",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": false,
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1": {},
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node:2.1.0",
    "ghcr.io/iyaki/devcontainer-features/oh-my-pi:1",
    "ghcr.io/iyaki/devcontainer-features/lefthook:2.0.1"
  ],
  "initializeCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": {
    "Android SDK (maui-android)": "bash .devcontainer/setup.sh",
    "Install agent-browser": "npm install -g agent-browser && agent-browser install --with-deps",
    "Install Playwright browsers": "bash .devcontainer/install-playwright.sh",
    "Configure git identity": "bash .devcontainer/configure-git-identity.sh",
    "Install git-extended helpers": "sudo install -m 0755 .agents/scripts/pm_detect.sh /usr/local/git-extended/pm_detect.sh && sudo install -m 0755 .agents/scripts/gcr.sh .agents/scripts/gwr.sh /usr/local/git-extended/functions/"
  },
  "postStartCommand": "DEV_START_DETACHED=1 bash .devcontainer/start-dev.sh",
  "remoteEnv": {
    "PODMAN_SOCKET": "/run/podman.sock",
    "DB_IMAGE_REPO": "ghcr.io/agustin-gigena/enigma-dev-db",
    "MYSQL_HOST": "enigma-dev-db",
    "MYSQL_PORT": "3306",
    "MYSQL_DATABASE": "enigma_db",
    "MYSQL_USER": "root",
    "MYSQL_PASSWORD": "root_password",
    "MYSQL_ROOT_PASSWORD": "root_password"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false,
        "remote.autoForwardPortSource": "process"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "patcx.vscode-nuget-gallery",
        "ms-azuretools.vscode-containers",
        "ms-dotnettools.dotnet-maui"
      ]
    }
  },
  "portsAttributes": {
    "*": {
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
