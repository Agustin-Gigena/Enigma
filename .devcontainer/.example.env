# ── Seguridad ──
# JWT: >=32 bytes, usado para firmar tokens HMAC-SHA256.
# Generá uno propio con: openssl rand -base64 32
ENIGMA_JWT_SECRET=<TU_SECRETO_AQUI>

# Seed del usuario admin (solo dev — crear usuario admin al arrancar)
ENIGMA_SEED_ADMIN_USER=admin
ENIGMA_SEED_ADMIN_PASSWORD=admin123

# ── HTTPS (dev certificate) ──
# Generá el cert con: dotnet dev-certs https -ep /tmp/https/aspnetapp.pfx -p enigma_dev_https
HTTPS_CERT_PATH=/tmp/https/aspnetapp.pfx
HTTPS_CERT_PASSWORD=enigma_dev_https

# ── Auth enforcement ──
# ENIGMA_AUTH_REQUIRED=true  # Descomentar para exigir auth en todas las rutas
