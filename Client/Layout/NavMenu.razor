@* Barra de módulos: dropdowns por módulo + overflow "Más +".
   Comportamiento (apertura/cierre/click-afuera/Escape) lo maneja EnigmaMenu
   vía data-menu; el estado activo lo resuelve NavLink. Suscripto a los cambios
   de AuthenticationState: al re-emitir sesión (cambio de institución, roles)
   el menú recalcula sin recargar la app. *@
@inject AuthenticationStateProvider AuthState
@using Enigma.Shared.Modules
@implements IDisposable

<nav class="app-nav" id="app-nav">
    @foreach (ModuloDef modulo in _modulosVisibles)
    {
        <details class="app-nav__modulo" data-menu data-modulo="@modulo.Clave">
            <summary>
                <span>@modulo.Etiqueta</span>
                <svg class="menu__chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </summary>
            <ul class="menu__lista">
                @foreach (SeccionDef seccion in SeccionesDe(modulo))
                {
                    <li data-modulo="@modulo.Clave">
                        <NavLink class="menu__item" href="@seccion.Ruta" ActiveClass="menu__item--activa">
                            @seccion.Etiqueta
                        </NavLink>
                    </li>
                }
            </ul>
        </details>
    }
    <details class="app-nav__modulo app-nav__mas" data-menu hidden>
        <summary aria-label="Más opciones">
            <span>Más +</span>
            <svg class="menu__chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </summary>
        <ul class="menu__lista"></ul>
    </details>
</nav>

@code {
    private List<ModuloDef> _modulosVisibles = [];
    private HashSet<string> _permisos = [];

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Recalcular cuando la sesión se re-emite (elección/cambio de institución,
        // roles propios actualizados): el menú vive de los claims vigentes.
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RecalcularAsync((await AuthState.GetAuthenticationStateAsync()).User);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> tarea)
    {
        try
        {
            AuthenticationState estado = await tarea;
            await RecalcularAsync(estado.User);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // El componente puede estar desmontándose: sin consecuencias.
        }
    }

    private Task RecalcularAsync(System.Security.Claims.ClaimsPrincipal usuario)
    {
        _permisos = [.. usuario.FindAll("permiso").Select(c => c.Value)];
        _modulosVisibles = [.. CatalogoModulos.Modulos
            .Where(m => CatalogoModulos.Secciones.Any(s => s.ModuloClave == m.Clave && _permisos.Contains(s.Clave)))
            .OrderBy(m => m.Orden)];
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("EnigmaMenu.init", "app-nav");
        }
    }

    private IEnumerable<SeccionDef> SeccionesDe(ModuloDef modulo) =>
        CatalogoModulos.Secciones
            .Where(s => s.ModuloClave == modulo.Clave && _permisos.Contains(s.Clave))
            .OrderBy(s => s.Orden);

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
