@* Buscador de secciones: un desplegable con búsqueda (MudAutocomplete).
   La lista la alimentan las secciones permitidas por los claims vigentes;
   se recalcula cuando la sesión se re-emite (cambio de institución o roles). *@
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@using Enigma.Shared.Modules
@using MudBlazor
@implements IDisposable

<div class="app-nav">
    <MudAutocomplete T="SeccionDef"
                     Value="_seleccionada"
                     ValueChanged="IrA"
                     SearchFunc="@Buscar"
                     ToStringFunc="@(s => s?.Etiqueta ?? "")"
                     Label="Buscar secciones…"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     MaxItems="10"
                     MinCharacters="0"
                     ResetValueOnEmptyText="true"
                     Clearable="true"
                     Class="app-nav__buscar"
                     @ref="_auto" />
</div>

@code {
    private List<SeccionDef> _seccionesPermitidas = [];
    private SeccionDef? _seleccionada;
    private MudAutocomplete<SeccionDef> _auto = default!;

    protected override async Task OnInitializedAsync()
    {
        // Recalcular cuando la sesión se re-emite (elección/cambio de institución,
        // roles propios actualizados): el buscador vive de los claims vigentes.
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RecalcularAsync((await AuthState.GetAuthenticationStateAsync()).User);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> tarea)
    {
        try
        {
            AuthenticationState estado = await tarea;
            await RecalcularAsync(estado.User);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // El componente puede estar desmontándose: sin consecuencias.
        }
    }

    private Task RecalcularAsync(System.Security.Claims.ClaimsPrincipal usuario)
    {
        HashSet<string> permisos = [.. usuario.FindAll("permiso").Select(c => c.Value)];
        _seccionesPermitidas = [.. CatalogoModulos.Secciones
            .Where(s => permisos.Contains(s.Clave))
            .OrderBy(s => s.Orden)];
        return Task.CompletedTask;
    }

    private void IrA(SeccionDef? seccion)
    {
        if (seccion is null)
        {
            return;
        }

        Navigation.NavigateTo(seccion.Ruta);
        _seleccionada = null;
    }

    private Task<IEnumerable<SeccionDef>> Buscar(string texto, CancellationToken ct)
    {
        List<SeccionDef> resultados = string.IsNullOrWhiteSpace(texto)
            ? _seccionesPermitidas
            : [.. _seccionesPermitidas.Where(s => s.Etiqueta.Contains(texto, StringComparison.OrdinalIgnoreCase))];
        return Task.FromResult<IEnumerable<SeccionDef>>(resultados);
    }

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
