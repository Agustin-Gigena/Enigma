@inherits LayoutComponentBase
@inject AuthService Auth
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Web
<div class="app">
    <header class="app__bar">
        <a class="enigma-brand" href="/">
            <img class="enigma-brand__logo" src="images/logo_size.jpg" alt="" width="28" height="28" />
            <span class="enigma-brand__name">Enigma</span>
        </a>

        <NavMenu />

        <div class="app__acciones">
            @if (_institucion is not null)
            {
                <SelectorInstitucion Activa="_institucion" />
            }
            <MenuCuenta NombreUsuario="@_sesion?.Usuario.NombreUsuario" />
        </div>
    </header>

    <main class="app__main">
        @* Red general de errores: cualquier excepción no manejada de las páginas
           muestra el mensaje amable en lugar de romper el shell. @key por URI:
           cada navegación arranca con el boundary limpio. *@
        <ErrorBoundary @key="Navigation.Uri">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="error">
                <section class="pagina">
                    <div class="estado estado--error" role="alert">
                        <p style="margin:0 0 0.4rem"><strong>Algo se rompió inesperadamente.</strong></p>
                        <p style="margin:0 0 0.4rem">El error ya quedó registrado. Probá de nuevo o volvé al inicio.</p>
                        <a class="boton" href="/" style="margin-top:0.5rem">Volver al inicio</a>
                    </div>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private SesionDto? _sesion;
    private InstitucionDto? _institucion;

    protected override async Task OnInitializedAsync()
    {
        _sesion = await Auth.GetSesionAsync();
        _institucion = await Auth.GetInstitucionActivaAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("EnigmaMotion.init");
        }
    }

}
