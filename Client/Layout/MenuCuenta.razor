@* Menú de cuenta: perfil, tema, cambio de institución y cierre de sesión.
   El cambio de institución vive acá (decisión de diseño: el appbar no lleva
   controles sueltos; un solo lugar para la cuenta en mobile y desktop). *@
@using MudBlazor
@using Enigma.Shared.Dtos

<MudMenu Class="app-cuenta"
         Label="@NombreUsuario"
         StartIcon="@Icons.Material.Filled.AccountCircle"
         EndIcon="@Icons.Material.Filled.ExpandMore"
         Color="Color.Inherit"
         Variant="Variant.Text"
         Dense="true"
         CloseOnItemClick="false">
    <MudMenuItem OnClick="() => { }">
        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
        Perfil
    </MudMenuItem>
    <MudMenuItem OnClick="AlternarTema">
        <MudIcon Icon="@(_temaOscuro ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Class="mr-2" />
        @(_temaOscuro ? "Pasar a tema claro" : "Pasar a tema oscuro")
    </MudMenuItem>
    @if (Otras.Count > 0)
    {
        <MudDivider Class="my-1" />
        <div class="app-cuenta__seccion">Cambiar institución</div>
        @if (Activa is not null)
        {
            <div class="app-cuenta__activa">@Activa.Nombre</div>
        }
        @foreach (InstitucionDto institucion in Otras)
        {
            <MudMenuItem OnClick="() => CambiarInstitucion(institucion)">
                <MudIcon Icon="@Icons.Material.Filled.HomeWork" Class="mr-2" />
                @institucion.Nombre
            </MudMenuItem>
        }
    }
    <MudDivider Class="my-1" />
    <MudMenuItem OnClick="CerrarSesion">Cerrar sesión</MudMenuItem>
</MudMenu>

@code {
    [Parameter] public string? NombreUsuario { get; set; }
    [Parameter] public InstitucionDto? Activa { get; set; }
    [Parameter] public IReadOnlyList<InstitucionDto> Otras { get; set; } = [];

    private bool _temaOscuro = true;

    [Inject] private AuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private Services.ThemeService Tema { get; set; } = default!;
    [Inject] private ServicioNotificaciones Notificar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Tema.Cambiado += SincronizarTema;
        await Tema.InicializarAsync();
        SincronizarTema();
    }

    private void SincronizarTema() => _ = InvokeAsync(() =>
    {
        _temaOscuro = Tema.Oscuro ?? true;
        StateHasChanged();
    });

    private void AlternarTema() => Tema.Fijar(!_temaOscuro);

    private async Task CambiarInstitucion(InstitucionDto institucion)
    {
        bool ok = await Auth.SeleccionarInstitucionAsync(institucion);
        if (ok)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Notificar.Error("No se pudo cambiar a esa institución. Intentá de nuevo.");
        }
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/auth/login");
    }

    public void Dispose() => Tema.Cambiado -= SincronizarTema;
}
