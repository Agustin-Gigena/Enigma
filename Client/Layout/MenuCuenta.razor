@* Menú de cuenta: patrón estándar Material (nombre + chevron como trigger).
   El nombre deja de ser texto decorativo: ES el trigger (hallazgo P2 de la
   crítica). El nombre del trigger vive dentro del dropdown. *@
@using MudBlazor

<MudMenu Class="app-cuenta"
         Label="@NombreUsuario"
         StartIcon="@Icons.Material.Filled.AccountCircle"
         EndIcon="@Icons.Material.Filled.ExpandMore"
         Color="Color.Inherit"
         Variant="Variant.Text"
         Dense="true"
         CloseOnItemClick="true">
    <MudMenuItem OnClick="CerrarSesion">Cerrar sesión</MudMenuItem>
    @* Ítems futuros: perfil, preferencias… *@
</MudMenu>

@code {
    [Parameter] public string? NombreUsuario { get; set; }

    [Inject] private AuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/auth/login");
    }
}
