@* Cambio de institución activa: re-emite la sesión y el shell recalcula por
   suscripción (SPA, sin recargar la app). MudMenu con popover: el nombre de
   la institución activa queda visible también en pantallas angostas
   (hallazgo P3 de la crítica). *@
@using MudBlazor
@inject AuthService Auth
@inject NavigationManager Navigation
@inject CancelacionNavegacion Nav

<MudMenu Class="app-institucion-menu"
         Label="@Activa?.Nombre"
         StartIcon="@Icons.Material.Filled.HomeWork"
         EndIcon="@Icons.Material.Filled.ExpandMore"
         Color="Color.Inherit"
         Variant="Variant.Text"
         Dense="true"
         CloseOnItemClick="true"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         title="Cambiar institución">
    @foreach (InstitucionDto institucion in _instituciones.Where(i => Activa is null || i.Id != Activa.Id))
    {
        <MudMenuItem OnClick="() => Cambiar(institucion)">@institucion.Nombre</MudMenuItem>
    }
</MudMenu>

@code {
    [Parameter] public InstitucionDto? Activa { get; set; }

    private List<InstitucionDto> _instituciones = [];

    protected override async Task OnInitializedAsync() =>
        _instituciones = await Auth.GetInstitucionesAsync(Nav.Token) ?? [];

    private async Task Cambiar(InstitucionDto institucion)
    {
        if (await Auth.SeleccionarInstitucionAsync(institucion, Nav.Token))
        {
            // Navegación SPA: la sesión se re-emite (NotifyAuthStateChanged) y el
            // menú/layout recalculan por suscripción — sin recargar la app.
            Navigation.NavigateTo("/");
        }
    }
}
