@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Enigma.Shared.Auth
@using Enigma.Shared.Modules
@using MudBlazor

<MudThemeProvider Theme="Themes.TemaEnigma.Instancia" IsDarkMode="_oscuro" IsDarkModeChanged="FijarTema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrada · Enigma</PageTitle>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <p role="alert">Lo sentimos, no encontramos esa página.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject Services.ThemeService Tema

@code {
    private bool _oscuro = true; // Coincide con el splash oscuro hasta leer la preferencia.

    protected override async Task OnInitializedAsync()
    {
        Tema.Cambiado += SincronizarTema;
        await Tema.InicializarAsync();
        SincronizarTema();
    }

    private void SincronizarTema()
    {
        _oscuro = Tema.Oscuro ?? true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void FijarTema(bool oscuro) => Tema.Fijar(oscuro);

    /// <summary>Guard central: toda navegación pasa por acá antes de resolver la ruta.
    /// El provider solo reporta "autenticado" con sesión completa (pre-auth ⇒ /auth/me
    /// da 403 ⇒ anónimo), así que autenticado ≡ institución elegida.</summary>
    private async Task OnNavigateAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext contexto)
    {
        string ruta = $"/{contexto.Path.TrimStart('/')}";
        AuthenticationState estado = await AuthState.GetAuthenticationStateAsync();
        bool autenticado = estado.User.Identity?.IsAuthenticated == true;

        // Rutas de auth: anónimas ok (login, selección). Con sesión completa no hay
        // nada que hacer acá: centraliza el redirect sesión→Home de la selección (T6).
        if (ruta.StartsWith("/auth"))
        {
            if (autenticado)
            {
                Redirigir(contexto, "/");
            }
            return;
        }

        if (ruta == "/acceso-denegado")
        {
            return;
        }

        // Rutas de sección del catálogo: exigen el claim permiso de esa sección.
        SeccionDef? seccion = CatalogoModulos.SeccionPorRuta(ruta);
        if (seccion is not null)
        {
            bool permitido = autenticado && estado.User.HasClaim(c => c.Type == "permiso" && c.Value == seccion.Clave);
            if (!permitido)
            {
                Redirigir(contexto, autenticado ? "/acceso-denegado" : "/auth/login");
            }
            return;
        }

        // Resto de la app: exige sesión con institución elegida.
        if (!autenticado)
        {
            Redirigir(contexto, "/auth/login");
        }
        else if (estado.User.FindFirst(EnigmaClaims.Institucion) is null)
        {
            Redirigir(contexto, "/auth/seleccion-institucion");
        }
    }

    /// <summary>Redirect SPA desde OnNavigateAsync: NavigationContext no expone
    /// RedirectTo en esta versión de Blazor; NavigateTo sin forceLoad cancela la
    /// navegación actual y re-arranca el ciclo para el destino (el guard corre de
    /// nuevo para la ruta nueva, que corta temprano). Sin recarga completa: la
    /// animación de arranque del WASM queda solo para la carga inicial.</summary>
    private void Redirigir(Microsoft.AspNetCore.Components.Routing.NavigationContext contexto, string destino)
    {
        contexto.CancellationToken.ThrowIfCancellationRequested();
        Navigation.NavigateTo(destino);
    }
}
