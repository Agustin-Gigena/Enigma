@using Microsoft.AspNetCore.Components.Authorization
@using Enigma.Shared.Auth
@using Enigma.Shared.Modules

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrada</PageTitle>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <p role="alert">Lo sentimos, no encontramos esa página.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // EnigmaMotion.init() es idempotente: ata una sola vez el
            // visibilitychange que pausa toda vida ambiental (.panel-vivo).
            await JS.InvokeVoidAsync("EnigmaMotion.init");
        }
    }

    /// <summary>Guard central: toda navegación pasa por acá antes de resolver la ruta.
    /// El provider solo reporta "autenticado" con sesión completa (pre-auth ⇒ /auth/me
    /// da 403 ⇒ anónimo), así que autenticado ≡ institución elegida.</summary>
    private async Task OnNavigateAsync(NavigationContext contexto)
    {
        string ruta = $"/{contexto.Path.TrimStart('/')}";
        AuthenticationState estado = await AuthState.GetAuthenticationStateAsync();
        bool autenticado = estado.User.Identity?.IsAuthenticated == true;

        // Rutas de auth: anónimas ok (login, selección). Con sesión completa no hay
        // nada que hacer acá: centraliza el redirect sesión→Home de la selección (T6).
        if (ruta.StartsWith("/auth"))
        {
            if (autenticado)
            {
                Redirigir(contexto, "/");
            }
            return;
        }

        if (ruta == "/acceso-denegado")
        {
            return;
        }

        // Rutas de sección del catálogo: exigen el claim permiso de esa sección.
        SeccionDef? seccion = CatalogoModulos.SeccionPorRuta(ruta);
        if (seccion is not null)
        {
            bool permitido = autenticado && estado.User.HasClaim(c => c.Type == "permiso" && c.Value == seccion.Clave);
            if (!permitido)
            {
                Redirigir(contexto, autenticado ? "/acceso-denegado" : "/auth/login");
            }
            return;
        }

        // Resto de la app: exige sesión con institución elegida.
        if (!autenticado)
        {
            Redirigir(contexto, "/auth/login");
        }
        else if (estado.User.FindFirst(EnigmaClaims.Institucion) is null)
        {
            Redirigir(contexto, "/auth/seleccion-institucion");
        }
    }

    /// <summary>Redirect desde OnNavigateAsync: NavigationContext no expone RedirectTo
    /// en esta versión de Blazor; el patrón soportado es NavigateTo con recarga forzada.</summary>
    private void Redirigir(NavigationContext contexto, string destino)
    {
        // Abortar la navegación vetada antes de forzar la nueva.
        contexto.CancellationToken.ThrowIfCancellationRequested();
        Navigation.NavigateTo(destino, forceLoad: true);
    }
}
