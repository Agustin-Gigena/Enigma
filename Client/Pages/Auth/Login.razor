@page "/auth/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation
@inject Services.ThemeService Tema
@inject ServicioNotificaciones Notificar
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using MudExtensions
@implements IDisposable

<PageTitle>Ingresá · Enigma</PageTitle>

<div class="login">
    <aside class="login__panel">
        <PanelVivo />


        <a class="enigma-brand" href="/">
            <img class="enigma-brand__logo" src="images/logo_size_invert.png" alt="" width="32" height="32" />
            <span class="enigma-brand__name">Enigma</span>
        </a>

        <div class="login__emblem" aria-hidden="true">
            <img src="images/logo_size_invert.png" alt="" width="96" height="96" />
        </div>

        <div class="login__panel-copy">
            <h2>La plataforma de tu institución</h2>
            <p>Todas tus instituciones, en un solo lugar.</p>
        </div>
    </aside>

    <main class="login__form">
        <div class="login__form-inner">
            <div class="login__topbar">
                <MudIconButton Icon="@(_temaOscuro ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Color="Color.Default" Variant="Variant.Text"
                               aria-label="Cambiar tema claro/oscuro"
                               OnClick="ToggleTheme" />
            </div>

            <h1>Ingresá</h1>
            <p class="login__lead">Accedé con tu usuario de la institución.</p>

            <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
                <MudTextField @bind-Value="_usuario" Label="Usuario" Variant="Variant.Outlined"
                              Immediate="false" autocomplete="username" placeholder="usuario"
                              Class="login__campo" Margin="Margin.Dense" />

                <MudPasswordField T="string" @bind-Text="_contrasena" Label="Contraseña" Variant="Variant.Outlined"
                                  Immediate="false" autocomplete="current-password"
                                  Class="login__campo" Margin="Margin.Dense" />

                <MudLoadingButton Loading="@_cargando" Variant="Variant.Filled" Color="Color.Primary"
                                  ButtonType="ButtonType.Submit" OnClick="LoginAsync" Class="login__submit" FullWidth="true">
                    Ingresá
                </MudLoadingButton>
            </form>
        </div>
    </main>
</div>

@code {
    private string _usuario = "";
    private string _contrasena = "";
    private bool _cargando;
    private bool _temaOscuro = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Tema.Cambiado += SincronizarTema;
        await Tema.InicializarAsync();
        SincronizarTema();
    }

    private void SincronizarTema() => _temaOscuro = Tema.Oscuro ?? true;

    private void ToggleTheme() => Tema.Fijar(!_temaOscuro);

    private async Task LoginAsync()
    {
        if (_cargando)
        {
            return;
        }

        _cargando = true;
        try
        {
            LoginResult resultado = await Auth.LoginAsync(_usuario.Trim(), _contrasena);
            if (!resultado.Ok || resultado.Datos is null)
            {
                Notificar.Error(resultado.Error ?? "No se pudo iniciar sesión. Intentá de nuevo.");
                return;
            }

            List<InstitucionDto> instituciones = resultado.Datos.Instituciones;
            if (instituciones.Count == 1)
            {
                bool ok = await Auth.SeleccionarInstitucionAsync(instituciones[0]);
                if (ok)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    Notificar.Error("No se pudo iniciar la sesión con esa institución. Intentá de nuevo.");
                }
            }
            else if (instituciones.Count > 1)
            {
                Navigation.NavigateTo("/auth/seleccion-institucion");
            }
            else
            {
                Navigation.NavigateTo("/auth/seleccion-institucion");
                Notificar.Advertencia("Tu usuario no tiene instituciones asignadas. Contactá al administrador.");
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    public void Dispose() => Tema.Cambiado -= SincronizarTema;
}
