@page "/auth/seleccion-institucion"
@layout AuthLayout
@inject AuthService Auth
@inject EnigmaAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@using MudBlazor
@using MudExtensions

<PageTitle>Elegí tu institución · Enigma</PageTitle>

<div class="seleccion">
    <header class="seleccion__header">
        <a class="enigma-brand" href="/">
            <svg class="enigma-brand__glyph enigma-brand__glyph--ink" viewBox="0 0 32 32" aria-hidden="true">
                <rect x="4" y="4" width="24" height="24" rx="7" />
                <path d="M11 11.5h10M11 16h6.5M11 20.5h9" />
            </svg>
            <span class="enigma-brand__name">Enigma</span>
        </a>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="CerrarSesion">Salir</MudButton>
    </header>

    <main class="seleccion__main">
        <h1>Elegí tu institución</h1>
        <p class="seleccion__lead">Tu usuario tiene acceso a varias instituciones. Elegí en cuál querés trabajar.</p>

        <MudLoading Loading="@_cargando" LoaderType="LoaderType.Circular">
            <ChildContent>
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert" Class="seleccion__error">@_error</MudAlert>
                }
                else
                {
                    <div class="seleccion__grilla">
                        @foreach (InstitucionDto institucion in _instituciones)
                        {
                            <MudCard Class="seleccion__tarjeta" Outlined="true" Elevation="0" @onclick="() => Seleccionar(institucion)">
                                <div class="seleccion__tarjeta-cuerpo">
                                    <span class="seleccion__tarjeta-nombre">@institucion.Nombre</span>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="seleccion__tarjeta-tipo">@institucion.Tipo</MudChip>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="seleccion__tarjeta-flecha" />
                            </MudCard>
                        }
                    </div>
                }
            </ChildContent>
            <LoaderContent>
                <div class="seleccion__grilla">
                    @for (int i = 0; i < 2; i++)
                    {
                        <MudSkeleton Width="100%" Height="109px" Rounded="true" />
                    }
                </div>
            </LoaderContent>
        </MudLoading>
    </main>
</div>

@code {
    private List<InstitucionDto> _instituciones = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Sin [Authorize]: la página vive en el limbo pre-autenticación (el /auth/me del
        // provider aún da 403). Si ya hay sesión completa, no tiene sentido volver a elegir.
        if (await AuthState.GetInstitucionActivaIdAsync() is not null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            _instituciones = await Auth.GetInstitucionesAsync();
            if (_instituciones.Count == 0)
            {
                _error = "Tu usuario no tiene instituciones asignadas. Contactá al administrador.";
            }
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar las instituciones. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task Seleccionar(InstitucionDto institucion)
    {
        _error = null;
        bool ok = await Auth.SeleccionarInstitucionAsync(institucion);
        if (ok)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = "No se pudo iniciar la sesión con esa institución. Intentá de nuevo.";
        }
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/auth/login");
    }
}
