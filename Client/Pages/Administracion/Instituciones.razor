@page "/administracion/instituciones"
@inject HttpClient Http

<PageTitle>Instituciones · Enigma</PageTitle>

<section class="pagina">
    <h1 class="pagina__titulo">Instituciones</h1>
    <p class="pagina__lead">Instituciones activas de este despliegue.</p>

    @if (_cargando)
    {
        <p class="estado estado--exito" role="status">Cargando instituciones…</p>
    }
    else if (_error is not null)
    {
        <p class="estado estado--error" role="alert">@_error</p>
    }
    else
    {
        <div class="pagina__superficie">
            <table class="tabla-admin">
                <thead>
                    <tr><th>Nombre</th><th>Tipo</th></tr>
                </thead>
                <tbody>
                    @foreach (InstitucionDto institucion in _instituciones)
                    {
                        <tr>
                            <td>@institucion.Nombre</td>
                            <td>@institucion.Tipo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<InstitucionDto> _instituciones = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instituciones = await Http.GetFromJsonAsync<List<InstitucionDto>>("administracion/instituciones") ?? [];
        }
        catch (Exception)
        {
            _error = "No se pudieron cargar las instituciones.";
        }
        finally
        {
            _cargando = false;
        }
    }
}
