@page "/administracion/instituciones"
@inject HttpClient Http
@inject Gsap Animaciones
@inject CancelacionNavegacion Nav
@inject ServicioNotificaciones Notificar
@inject IDialogService Dialogos
@using Enigma.Client.Shared
@using Enigma.Client.Shared.Dialogos
@using MudBlazor

<PageTitle>Instituciones · Enigma</PageTitle>

<section class="pagina">
    <div class="pagina__toolbar">
        <div>
            <h1 class="pagina__titulo">Instituciones</h1>
            <p class="pagina__lead">Instituciones activas del sistema.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness"
                   OnClick="AbrirNueva" Class="boton">+ Nueva institución</MudButton>
    </div>

    <div class="pagina__superficie">
        <MudTable T="InstitucionDto" Items="@_instituciones" Hover="true" Elevation="0"
                  Class="tabla-admin" Loading="@_cargando" LoadingProgressColor="Color.Primary">
            <LoadingContent>
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
            </LoadingContent>
            <HeaderContent>
                <MudTh T="InstitucionDto">Nombre</MudTh>
                <MudTh T="InstitucionDto">Tipo</MudTh>
                <MudTh T="InstitucionDto" Class="tabla-admin__acciones"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd T="InstitucionDto" DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd T="InstitucionDto" DataLabel="Tipo">@context.Tipo</MudTd>
                <MudTd T="InstitucionDto" Class="tabla-admin__acciones">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       aria-label="@($"Editar {context.Nombre}")"
                                       OnClick="@(() => AbrirEdicion(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                       aria-label="@($"Eliminar {context.Nombre}")"
                                       OnClick="@(() => ConfirmarEliminar(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="vacio">
                    <p class="vacio__titulo">Todavía no hay instituciones</p>
                    <p>Creá la primera para empezar a organizar usuarios y secciones.</p>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="AbrirNueva">+ Nueva institución</MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    private List<InstitucionDto> _instituciones = [];
    private bool _cargando = true;
    private bool _animadas;

    private static readonly DialogOptions OpcionesDialogo = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = false
    };

    protected override async Task OnInitializedAsync()
    {
        // Carga vacía ([]) NO es error: null sí lo es (falla de red/API).
        List<InstitucionDto>? datos = await Http.GetSeguroAsync<List<InstitucionDto>>("administracion/instituciones", Nav.Token);
        if (datos is null)
        {
            Notificar.Error("No se pudieron cargar las instituciones.");
        }
        _instituciones = datos ?? [];
        _cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_animadas && _instituciones.Count > 0)
        {
            _animadas = true;
            await Animaciones.EntradaEscalonadaAsync(".tabla-admin tbody tr");
        }
    }

    private async Task RecargarAsync()
    {
        _instituciones = await Http.GetSeguroAsync<List<InstitucionDto>>("administracion/instituciones", Nav.Token) ?? [];
    }

    private async Task AbrirNueva()
    {
        await EditarYGuardarAsync(inicial: null, mensajeExito: "Institución creada.");
    }

    private async Task AbrirEdicion(InstitucionDto institucion)
    {
        await EditarYGuardarAsync(institucion, mensajeExito: "Institución actualizada.");
    }

    private async Task EditarYGuardarAsync(InstitucionDto? inicial, string mensajeExito)
    {
        IDialogReference referencia = await Dialogos.ShowAsync<DialogoInstitucion>(
            inicial is null ? "Nueva institución" : "Editar institución",
            new DialogParameters { { nameof(DialogoInstitucion.Inicial), inicial } },
            OpcionesDialogo);
        DatosInstitucion? datos = await referencia.GetReturnValueAsync<DatosInstitucion?>();
        if (datos is null)
        {
            return;
        }

        InstitucionRequest cuerpo = new(datos.Nombre, datos.Tipo);
        HttpResponseMessage? respuesta = inicial is null
            ? await Http.PostSeguroAsync("administracion/instituciones", cuerpo, Nav.Token)
            : await Http.PutSeguroAsync($"administracion/instituciones/{inicial.Id}", cuerpo, Nav.Token);

        if (respuesta is null || !respuesta.IsSuccessStatusCode)
        {
            await Notificar.ErrorAsync("No se pudo guardar la institución:", respuesta);
            return;
        }

        await RecargarAsync();
        Notificar.Exito(mensajeExito);
        _animadas = false;
    }

    private async Task ConfirmarEliminar(InstitucionDto institucion)
    {
        IDialogReference referencia = await Dialogos.ShowAsync<DialogoConfirmacion>(
            "Eliminar institución",
            new DialogParameters
            {
                { nameof(DialogoConfirmacion.Texto), $"¿Eliminar {institucion.Nombre}?" },
                { nameof(DialogoConfirmacion.Detalle), "Es un borrado lógico: deja de aparecer en todo el sistema, pero el historial auditado se conserva." },
                { nameof(DialogoConfirmacion.TextoAccion), "Eliminar" },
                { nameof(DialogoConfirmacion.ConfirmarAsync), (Func<Task<bool>>)(async () =>
                    {
                        HttpResponseMessage? respuesta = await Http.DeleteAsync(
                            $"administracion/instituciones/{institucion.Id}", Nav.Token);
                        bool ok = respuesta is not null && respuesta.IsSuccessStatusCode;
                        if (ok)
                        {
                            await RecargarAsync();
                            Notificar.Exito("Institución eliminada.");
                        }
                        else
                        {
                            await Notificar.ErrorAsync("No se pudo eliminar la institución.", respuesta);
                        }
                        return ok;
                    }) }
            },
            OpcionesDialogo);
        await referencia.Result;
    }
}
