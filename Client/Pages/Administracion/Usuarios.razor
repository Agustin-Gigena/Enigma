@page "/administracion/usuarios"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Navigation
@inject Gsap Animaciones
@inject CancelacionNavegacion Nav
@inject ServicioNotificaciones Notificar
@inject IDialogService Dialogos
@using Enigma.Client.Shared
@using Enigma.Client.Shared.Dialogos
@using MudBlazor

<PageTitle>Usuarios · Enigma</PageTitle>

<section class="pagina">
    <div class="pagina__toolbar">
        <div>
            <h1 class="pagina__titulo">Usuarios</h1>
            <p class="pagina__lead">Miembros de la institución activa y sus roles.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="AbrirAlta" Class="boton">+ Agregar usuario</MudButton>
    </div>

    <div class="pagina__superficie">
        <MudTable T="UsuarioInstitucionDto" Items="@_usuarios" Hover="true" Elevation="0"
                  Class="tabla-admin" Loading="@_cargando" LoadingProgressColor="Color.Primary">
            <LoadingContent>
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
                <MudSkeleton Width="100%" Height="34px" Rounded="true" />
            </LoadingContent>
            <HeaderContent>
                <MudTh T="UsuarioInstitucionDto">Usuario</MudTh>
                <MudTh T="UsuarioInstitucionDto">Roles</MudTh>
                <MudTh T="UsuarioInstitucionDto" Class="tabla-admin__acciones"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd T="UsuarioInstitucionDto" DataLabel="Usuario">
                    <div class="usuario-celda">
                        <span class="usuario-celda__nombre">@context.Usuario.NombreUsuario</span>
                        @if (!string.IsNullOrEmpty(context.Usuario.Correo))
                        {
                            <span class="usuario-celda__correo">@context.Usuario.Correo</span>
                        }
                    </div>
                </MudTd>
                <MudTd T="UsuarioInstitucionDto" DataLabel="Roles">
                    <div class="chips">
                        @foreach (string rol in context.Roles)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@rol</MudChip>
                        }
                        @if (context.Roles.Count == 0)
                        {
                            <span class="chips__vacio">Sin roles</span>
                        }
                    </div>
                </MudTd>
                <MudTd T="UsuarioInstitucionDto" Class="tabla-admin__acciones">
                    <MudTooltip Text="Editar roles">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       aria-label="@($"Editar roles de {context.Usuario.NombreUsuario}")"
                                       OnClick="@(() => AbrirRoles(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Quitar de la institución">
                        <MudIconButton Icon="@Icons.Material.Outlined.PersonRemove" Size="Size.Small" Color="Color.Error"
                                       aria-label="@($"Quitar a {context.Usuario.NombreUsuario}")"
                                       OnClick="@(() => ConfirmarQuitar(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="vacio">
                    <p class="vacio__titulo">Nadie en esta institución todavía</p>
                    <p>Agregá el primer usuario y asignale roles para que acceda a las secciones.</p>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="AbrirAlta">+ Agregar usuario</MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    private List<UsuarioInstitucionDto> _usuarios = [];
    private List<RolDto> _roles = [];
    private bool _cargando = true;
    private bool _filasAnimadas;

    private static readonly DialogOptions OpcionesDialogo = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = false
    };

    protected override async Task OnInitializedAsync()
    {
        // Carga vacía ([]) NO es error: null sí lo es (falla de red/API).
        List<UsuarioInstitucionDto>? usuarios = await Http.GetSeguroAsync<List<UsuarioInstitucionDto>>("administracion/usuarios", Nav.Token);
        _roles = await Http.GetSeguroAsync<List<RolDto>>("administracion/usuarios/roles", Nav.Token) ?? [];
        if (usuarios is null)
        {
            Notificar.Error("No se pudieron cargar los usuarios.");
        }
        _usuarios = usuarios ?? [];
        _cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_filasAnimadas && _usuarios.Count > 0)
        {
            _filasAnimadas = true;
            await Animaciones.EntradaEscalonadaAsync(".tabla-admin tbody tr");
        }
    }

    private async Task RecargarAsync()
    {
        _usuarios = await Http.GetSeguroAsync<List<UsuarioInstitucionDto>>("administracion/usuarios", Nav.Token) ?? [];
    }

    private async Task AbrirAlta()
    {
        IDialogReference referencia = await Dialogos.ShowAsync<DialogoAltaUsuario>(
            "Agregar usuario", new DialogParameters { { nameof(DialogoAltaUsuario.Roles), _roles } }, OpcionesDialogo);
        DatosAltaUsuario? datos = await referencia.GetReturnValueAsync<DatosAltaUsuario?>();
        if (datos is null)
        {
            return;
        }

        HttpResponseMessage? respuesta = await Http.PostSeguroAsync(
            "administracion/usuarios",
            new AltaUsuarioRequest(datos.Usuario, datos.Correo, datos.Contrasena, datos.Roles),
            Nav.Token);
        if (respuesta is null || !respuesta.IsSuccessStatusCode)
        {
            await Notificar.ErrorAsync("No se pudo crear el usuario:", respuesta);
            return;
        }

        await RecargarAsync();
        Notificar.Exito("Usuario agregado a la institución.");
        _filasAnimadas = false;
    }

    private async Task AbrirRoles(UsuarioInstitucionDto usuario)
    {
        IDialogReference referencia = await Dialogos.ShowAsync<DialogoRolesUsuario>(
            "Editar roles",
            new DialogParameters
            {
                { nameof(DialogoRolesUsuario.Usuario), usuario },
                { nameof(DialogoRolesUsuario.RolesDisponibles), _roles }
            },
            OpcionesDialogo);
        List<string>? roles = await referencia.GetReturnValueAsync<List<string>?>();
        if (roles is null)
        {
            return;
        }

        HttpResponseMessage? respuesta = await Http.PutSeguroAsync(
            $"administracion/usuarios/{usuario.Usuario.Id}/roles",
            new ActualizarRolesRequest(roles), Nav.Token);
        if (respuesta is null || !respuesta.IsSuccessStatusCode)
        {
            Notificar.Error("No se pudieron guardar los roles.");
            return;
        }

        bool soloAdiciones = usuario.Roles.All(roles.Contains);
        int usuarioId = usuario.Usuario.Id;

        await RecargarAsync();
        Notificar.Exito("Roles actualizados.");
        _filasAnimadas = false;

        // Autorefresco solo si te editaste a vos mismo y SOLO ganaste permisos:
        // re-emitir tras perderlos te dejaría fuera de esta página en el acto.
        SesionDto? sesion = await Auth.GetSesionAsync(Nav.Token);
        if (sesion is not null && sesion.Usuario.Id == usuarioId && soloAdiciones)
        {
            InstitucionDto? activa = await Auth.GetInstitucionActivaAsync();
            if (activa is not null)
            {
                await Auth.SeleccionarInstitucionAsync(activa, Nav.Token);
                Navigation.NavigateTo("/administracion/usuarios");
            }
        }
    }

    private async Task ConfirmarQuitar(UsuarioInstitucionDto usuario)
    {
        IDialogReference referencia = await Dialogos.ShowAsync<DialogoConfirmacion>(
            "Quitar de la institución",
            new DialogParameters
            {
                { nameof(DialogoConfirmacion.Texto), $"¿Quitar a {usuario.Usuario.NombreUsuario} de esta institución?" },
                { nameof(DialogoConfirmacion.Detalle), "Pierde el acceso a sus secciones acá; sus otras instituciones no se tocan. Es un borrado lógico auditable." },
                { nameof(DialogoConfirmacion.TextoAccion), "Quitar" },
                { nameof(DialogoConfirmacion.ConfirmarAsync), (Func<Task<bool>>)(async () =>
                    {
                        HttpResponseMessage? respuesta = await Http.DeleteAsync(
                            $"administracion/usuarios/{usuario.Usuario.Id}", Nav.Token);
                        bool ok = respuesta is not null && respuesta.IsSuccessStatusCode;
                        if (ok)
                        {
                            await RecargarAsync();
                            Notificar.Exito("Usuario quitado de la institución.");
                            _filasAnimadas = false;
                        }
                        else
                        {
                            await Notificar.ErrorAsync("No se pudo quitar al usuario.", respuesta);
                        }
                        return ok;
                    }) }
            },
            OpcionesDialogo);
        await referencia.Result;
    }
}
