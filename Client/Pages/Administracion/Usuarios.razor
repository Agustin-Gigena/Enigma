@page "/administracion/usuarios"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Navigation
@inject CancelacionNavegacion Nav
@inject Gsap Animaciones
<PageTitle>Usuarios · Enigma</PageTitle>

<section class="pagina">
    <h1 class="pagina__titulo">Usuarios</h1>
    <p class="pagina__lead">Miembros de la institución activa y sus roles.</p>

    @if (_cargando)
    {
        <p class="estado estado--exito" role="status">Cargando usuarios…</p>
    }
    else if (_error is not null)
    {
        <p class="estado estado--error" role="alert">@_error</p>
    }
    else
    {
        <div class="pagina__superficie">
            <table class="tabla-admin">
                <thead>
                    <tr><th>Usuario</th><th>Roles</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (UsuarioInstitucionDto usuario in _usuarios)
                {
                    <tr>
                        <td>@usuario.Usuario.NombreUsuario</td>
                        <td>
                            @foreach (RolDto rol in _roles)
                            {
                                <label class="rol-check">
                                    <input type="checkbox" name="@rol.Nombre"
                                           checked="@(usuario.Roles.Contains(rol.Nombre))"
                                           @onchange="e => Toggle(usuario, rol.Nombre, e.Value)" />
                                    @rol.Nombre
                                </label>
                            }
                        </td>
                        <td>
                            <button type="button" class="boton" @onclick="() => Guardar(usuario)" disabled="@_guardando">Guardar</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (_mensaje is not null)
        {
            <p class="estado estado--exito" role="status">@_mensaje</p>
        }
    }
</section>

@code {
    private List<UsuarioInstitucionDto> _usuarios = [];
    private List<RolDto> _roles = [];
    private readonly Dictionary<int, HashSet<string>> _cambios = [];
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _mensaje;

    // Cancelación/red: HttpSeguro devuelve null (sin lanzar).
    protected override async Task OnInitializedAsync()
    {
        _usuarios = await Http.GetSeguroAsync<List<UsuarioInstitucionDto>>("administracion/usuarios", Nav.Token) ?? [];
        _roles = await Http.GetSeguroAsync<List<RolDto>>("administracion/usuarios/roles", Nav.Token) ?? [];
        _error = _usuarios.Count == 0 ? "No se pudieron cargar los usuarios." : null;
        _cargando = false;
    }

    private void Toggle(UsuarioInstitucionDto usuario, string rol, object? valor)
    {
        HashSet<string> set = _cambios.TryGetValue(usuario.Usuario.Id, out HashSet<string>? existente)
            ? existente
            : _cambios[usuario.Usuario.Id] = [.. usuario.Roles];
        if (valor is true)
        {
            set.Add(rol);
        }
        else
        {
            set.Remove(rol);
        }
    }

    private async Task Guardar(UsuarioInstitucionDto usuario)
    {
        _guardando = true;
        _mensaje = null;
        try
        {
            List<string> roles = _cambios.TryGetValue(usuario.Usuario.Id, out HashSet<string>? set)
                ? [.. set]
                : usuario.Roles;
            HttpResponseMessage? respuesta = await Http.PutSeguroAsync(
                $"administracion/usuarios/{usuario.Usuario.Id}/roles", new ActualizarRolesRequest(roles), Nav.Token);
            if (respuesta is null || !respuesta.IsSuccessStatusCode)
            {
                _error = "No se pudieron guardar los roles.";
                return;
            }


            _mensaje = "Roles actualizados.";
            bool soloAdiciones = usuario.Roles.All(roles.Contains);
            usuario.Roles.Clear();
            usuario.Roles.AddRange(roles);

            // Feedback de la fila guardada (GSAP vía servicio — sin JS directo).
            await Animaciones.PulsoAsync($".tabla-admin tbody tr:nth-child({_usuarios.IndexOf(usuario) + 1})");


            // Si el editado es el usuario actual y solo ganó accesos (no perdió ninguno),
            // refrescar su propia sesión (token + menú con permisos nuevos). Si perdió
            // accesos NO se re-emite: el token vigente mantiene los permisos hasta la
            // próxima validación — re-emitir al vacío lo dejaría sin sección en el acto,
            // sin siquiera poder restaurar su propio error desde esta página.
            SesionDto? sesion = await Auth.GetSesionAsync(Nav.Token);
            if (sesion is not null && sesion.Usuario.Id == usuario.Usuario.Id && soloAdiciones)
            {
                InstitucionDto? activa = await Auth.GetInstitucionActivaAsync();
                if (activa is not null)
                {
                    // Re-emitir la sesión dispara el cascade de AuthenticationState, que
                    // desmonta y recrea esta página (el mensaje inline se pierde con la
                    // instancia). Recarga determinista: el shell recalcula menú/permisos
                    // y la página vuelve con el estado persistido.
                    await Auth.SeleccionarInstitucionAsync(activa, Nav.Token);
                    // SPA: la página se re-monta por el cascade del cambio de auth
                    // state; el menú recalcula por suscripción. Sin recarga completa.
                    Navigation.NavigateTo("/administracion/usuarios");
                }
            }
        }
        finally
        {
            _guardando = false;
        }
    }

    private bool _filasAnimadas;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Entrada escalonada de filas (GSAP vía servicio — sin JS directo), una vez.
        if (!_filasAnimadas && _usuarios.Count > 0)
        {
            _filasAnimadas = true;
            await Animaciones.EntradaEscalonadaAsync(".tabla-admin tbody tr");
        }
    }
}
