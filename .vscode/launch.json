{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Debugger .NET para el Server (API). Funciona dentro del devcontainer
            // (la extensión C# instala vsdbg en el primer debug). F5 adjunta breakpoints C#.
            // Oculta del dropdown: se lanza solo vía el compound "Enigma (Server + Client)".
            "name": "Server (.NET Core)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prelaunch-server",
            "program": "${workspaceFolder}/src/Enigma.Api/bin/Debug/net10.0/Enigma.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Enigma.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:8081",
                "HTTP_PORTS": ""
            },
            "console": "internalConsole",
            "presentation": { "hidden": true }
        },
        {
            // Levanta el dev server de Blazor WASM en :8080 (dotnet run). No debugea
            // el WASM (corre en el navegador del host); sirve la app para abrir
            // http://localhost:8080. Oculta del dropdown: se lanza solo vía el compound.
            "name": "Client (.NET Core)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prelaunch-client",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/Enigma.Web/Enigma.Web.csproj",
                "--launch-profile",
                "http",
                "--no-build"
            ],
            "cwd": "${workspaceFolder}/src/Enigma.Web",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole",
            "launchBrowser": {
                "enabled": true
            },
            "presentation": { "hidden": true }
        },
        {
            // SOLO útil si VS Code corre NATIVO en el HOST (no en devcontainer):
            // el container no tiene navegador. Oculta del dropdown.
            "name": "Launch Chrome (Client)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/src/Enigma.Web",
            "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
            "presentation": { "hidden": true }
        },
        {
            // Debug del app MAUI en Android (extensión ms-dotnettools.dotnet-maui):
            // al lanzar, la extensión pide el dispositivo/emulador objetivo (via
            // adb del container — el SDK está horneado en /usr/local/android-sdk).
            // Para un emulador en el HOST: `adb -a nodaemon server start` en el
            // host y `adb connect 10.89.0.1:5555` desde el container (gateway de
            // enigma-dev-net).
            "name": "Maui (Android)",
            "type": "maui",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/Enigma.Maui/Enigma.Maui.csproj",
            "configuration": "Debug"
        }
    ],
    "compounds": [
        {
            // Única opción de inicio visible: F5 levanta el stack completo —
            // Server (debuggable, :8081) + Client dev server (:8080). En el devcontainer
            // abrí http://localhost:8080 en el navegador del host. stopAll: al detener
            // la sesión, caen ambos procesos.
            "name": "Enigma (Server + Client)",
            "configurations": ["Server (.NET Core)", "Client (.NET Core)"],
            "stopAll": true
        },
        {
            // F5 alternativo: API debuggable (:8081 — el emulador la alcanza por
            // 10.0.2.2:8081) + app MAUI Android en el dispositivo. Alternativa sin
            // debugger: task "dev-android".
            "name": "Enigma (API + Android)",
            "configurations": ["Server (.NET Core)", "Maui (Android)"],
            "stopAll": true
        }
    ]
}
