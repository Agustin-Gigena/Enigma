{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Enigma.Api/Enigma.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-client",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Enigma.Web/Enigma.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "watch-server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/Enigma.Api/Enigma.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-watch-server",
        "pattern": {
          "regexp": "^\\b\\B"
        },
        "fileLocation": "relative",
        "activeOnStart": true,
        "beginsPattern": "watch :",
        "endsPattern": "Now listening on"
      }
    },
    {
      "label": "watch-client",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/Enigma.Web/Enigma.Web.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-watch-client",
        "pattern": {
          "regexp": "^\\b\\B"
        },
        "fileLocation": "relative",
        "activeOnStart": true,
        "beginsPattern": "watch :",
        "endsPattern": "Now listening on"
      }
    },
    {
      "label": "dev",
      "dependsOn": [
        "watch-server",
        "watch-client"
      ],
      "problemMatcher": []
    },
    {
      "label": "free-dev-ports",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "${workspaceFolder}/scripts/free-ports.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "prelaunch-server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "free-dev-ports",
        "build-server"
      ],
      "problemMatcher": []
    },
    {
      "label": "prelaunch-client",
      "dependsOrder": "sequence",
      "dependsOn": [
        "free-dev-ports",
        "build-client"
      ],
      "problemMatcher": []
    }
  ]
}